# API 认证密钥,Laravel/UI 通过 X-API-Key 头携带。留空表示不鉴权(仅限内网!)
API_KEY=changeme

# 容器运行用户(非 root):duckdb-api 与 Metabase 镜像以此 uid/gid 运行,
# 修改后需 docker compose build。建议与 Docker 宿主机用户一致,方便读写 ./localdata 等 bind mount。
# 注意:已有部署改动 uid 后,需要对旧 volume 做一次 chown(见 README「非 root 运行」)
USER_NAME=app
GROUP_NAME=app
USER_UID=1000
GROUP_GID=1000

# 端口映射
API_PORT=8080
METABASE_PORT=3000
SUPERSET_PORT=8088

# Superset:务必改掉 SECRET_KEY(可用 `openssl rand -base64 42` 生成)和管理员密码
SUPERSET_SECRET_KEY=please-change-this-in-env-file
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin123
SUPERSET_ADMIN_EMAIL=admin@localhost.local

# 查询限制
MAX_ROWS=10000
QUERY_TIMEOUT=300

# 是否允许写语句(CREATE TABLE / COPY 等),默认只读
ALLOW_WRITE=false

# Metabase 自动同步:配置后每次增删改表都会立即触发 Metabase 重新扫描 schema,
# 新表马上可见(否则要等 Metabase 的定时扫描或手动 Sync)。
# 在 Metabase 里创建:Admin settings → Authentication → API keys → Create(组选 Administrators)
METABASE_API_KEY=

# 本地文件表目录:宿主机此目录挂载为两个容器内的 /local,
# 放 parquet/csv/json 后用路径 /local/xxx.parquet 注册表
LOCAL_DATA_DIR=./localdata

# Metabase JVM 时区
TZ=Australia/Sydney
